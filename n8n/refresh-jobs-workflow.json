{
  "name": "Refresh sports jobs dashboard",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Every morning at 7",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/orko-punter/sports-jobs-dashboard/actions/workflows/refresh.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"ref\": \"main\"}",
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Start GitHub refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "amount": 4,
        "unit": "minutes"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Wait for refresh",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [480, 0],
      "webhookId": "a1b2c3d4-0003-4000-8000-0000000000aa"
    },
    {
      "parameters": {
        "url": "https://orko-punter.github.io/sports-jobs-dashboard/new_jobs.json",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Get new jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Every morning at 7": {
      "main": [[{ "node": "Start GitHub refresh", "type": "main", "index": 0 }]]
    },
    "Start GitHub refresh": {
      "main": [[{ "node": "Wait for refresh", "type": "main", "index": 0 }]]
    },
    "Wait for refresh": {
      "main": [[{ "node": "Get new jobs", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
